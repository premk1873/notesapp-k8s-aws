<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account · CloudNotes</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="auth-wrapper">

    <!-- Decorative branding panel (hidden on small screens) -->
    <div class="auth-panel">
      <div class="note-stack" aria-hidden="true">
        <div class="stack-card stack-card--1"></div>
        <div class="stack-card stack-card--4"></div>
        <div class="stack-card stack-card--2"></div>
        <div class="stack-card stack-card--3"></div>
      </div>
      <div class="brand-content">
        <div class="brand-logo"><i class="bi bi-journal-text"></i> CloudNotes</div>
        <h1>Create your account.</h1>
        <p>It takes less than a minute. Your notes will be private, and only ever visible to you.</p>
      </div>
    </div>

    <!-- Registration form -->
    <div class="auth-form-panel">
      <div class="auth-form-card">
        <div class="mobile-brand"><i class="bi bi-journal-text"></i> CloudNotes</div>

        <h2>Create account</h2>
        <p class="auth-subtitle">Fill in your details to get started.</p>

        <% if (error) { %>
          <div class="alert alert-danger mb-4" role="alert">
            <i class="bi bi-exclamation-circle-fill me-1"></i> <%= error %>
          </div>
        <% } %>

        <form action="/register" method="POST" novalidate>
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <div class="input-icon-group">
              <i class="bi bi-person-badge"></i>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                placeholder="Your full name"
                autocomplete="name"
                minlength="2"
                maxlength="100"
                value="<%= formData.name || '' %>"
                required
              >
            </div>
          </div>

          <div class="mb-3">
            <label for="user_id" class="form-label">User ID</label>
            <div class="input-icon-group">
              <i class="bi bi-person"></i>
              <input
                type="text"
                class="form-control"
                id="user_id"
                name="user_id"
                placeholder="Choose a unique User ID"
                autocomplete="username"
                minlength="3"
                maxlength="50"
                pattern="[a-zA-Z0-9_.]+"
                value="<%= formData.user_id || '' %>"
                required
              >
              <div class="form-text mt-1">Letters, numbers, dots, and underscores only.</div>
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <div class="input-icon-group">
              <i class="bi bi-lock"></i>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="At least 6 characters"
                autocomplete="new-password"
                minlength="6"
                required
              >
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100">Create Account</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
