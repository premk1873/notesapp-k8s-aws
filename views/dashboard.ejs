<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard · CloudNotes</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top navbar -->
  <nav class="app-navbar">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="brand"><i class="bi bi-journal-text"></i> CloudNotes</div>
      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="btn btn-secondary btn-sm">
          <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button>
      </form>
    </div>
  </nav>

  <!-- Welcome header + New Note action -->
  <div class="container dashboard-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
      <div>
        <div class="welcome">Welcome back,</div>
        <h1><%= userName %></h1>
      </div>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newNoteModal">
        <i class="bi bi-plus-lg me-1"></i> New Note
      </button>
    </div>
  </div>

  <!-- Notes -->
  <div class="container pb-5">
    <% if (error) { %>
      <div class="alert alert-danger mb-4" role="alert"><%= error %></div>
    <% } %>

    <% if (notes.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-journal-plus"></i></div>
        <h3>No notes yet</h3>
        <p>Create your first note to see it here.</p>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% notes.forEach(function (note) { %>
          <div class="col">
            <div class="note-card">
              <div class="note-content"><%= note.content %></div>
              <div class="note-meta">
                <div><i class="bi bi-clock-history me-1"></i>Created: <%= note.created_display %></div>
                <div><i class="bi bi-arrow-clockwise me-1"></i>Updated: <%= note.updated_display %></div>
              </div>
              <div class="note-actions">
                <a href="/notes/edit/<%= note.id %>" class="btn btn-secondary btn-sm-icon" title="Edit note" aria-label="Edit note">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/notes/delete/<%= note.id %>" method="POST" class="js-delete-note-form m-0">
                  <button type="submit" class="btn btn-danger-soft btn-sm-icon" title="Delete note" aria-label="Delete note">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- New Note modal -->
  <div class="modal fade" id="newNoteModal" tabindex="-1" aria-labelledby="newNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form action="/notes/create" method="POST">
          <div class="modal-header">
            <h5 class="modal-title" id="newNoteModalLabel">New Note</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <textarea
              class="form-control"
              name="content"
              rows="6"
              placeholder="Write your note here..."
              required
            ></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Note</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
