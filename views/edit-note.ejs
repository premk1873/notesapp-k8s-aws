<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Note · CloudNotes</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="edit-note-wrapper">
    <div class="edit-note-card">
      <a href="/dashboard" class="back-link"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>

      <h2>Edit Note</h2>
      <p class="auth-subtitle mb-4">
        Created <%= note.created_display %> &middot; Last updated <%= note.updated_display %>
      </p>

      <% if (error) { %>
        <div class="alert alert-danger mb-4" role="alert"><%= error %></div>
      <% } %>

      <form action="/notes/update/<%= note.id %>" method="POST">
        <div class="mb-4">
          <label for="content" class="form-label">Note Content</label>
          <textarea
            class="form-control"
            id="content"
            name="content"
            rows="8"
            required
          ><%= note.content %></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/dashboard" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
